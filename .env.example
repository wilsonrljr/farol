APP_NAME=Farol
API_TITLE=Farol API
API_DESCRIPTION=Plataforma Farol: simulação e planejamento financeiro (imóveis focados inicialmente).
API_VERSION=0.1.0

# Backend server settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=["*"]
CORS_ALLOW_HEADERS=["*"]
CORS_EXPOSE_HEADERS=["Content-Disposition","X-Request-ID"]
# Must match the reverse-proxy body limit in production (4 MiB by default).
MAX_REQUEST_BODY_BYTES=4194304
ENABLE_REQUEST_ID=true

# Future: external service keys (never commit real keys)
# SENTRY_DSN=
# ANALYTICS_KEY=
